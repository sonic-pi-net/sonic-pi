<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Runs the process with a UTF-8 active code page so narrow-string APIs
  (getenv, CRT file I/O, process arguments) agree with ghc::filesystem's
  UTF-8 interpretation of paths. Without this, a non-ASCII home directory
  (e.g. C:\Users\René) is decoded two different ways and boot fails.
  Requires Windows 10 1903+; older systems ignore the setting and keep
  the legacy ANSI code page.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
