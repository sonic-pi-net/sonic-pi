diff --git a/mrbgems/mruby-bin-mrbc/bintest/mrbc.rb b/mrbgems/mruby-bin-mrbc/bintest/mrbc.rb
index 7d99023ea..f6f5f371a 100644
--- a/mrbgems/mruby-bin-mrbc/bintest/mrbc.rb
+++ b/mrbgems/mruby-bin-mrbc/bintest/mrbc.rb
@@ -322,3 +322,33 @@ assert('a body returns on the line of the end that closes it') do
     assert_equal [4, 7, 10, 13, 14], returns.drop(1)
   end
 end
+
+assert('a C struct dump leaves no symbol to be filled in when an interpreter starts') do
+  # The structs `-S` writes are static, and every interpreter of a process
+  # runs them. A symbol with no `MRB_SYM`-style name (`$!`, `:"a b"`) used to be
+  # left 0 in its table and interned by each interpreter as it started, into
+  # that one table: interpreters starting on different threads wrote it at
+  # once, and the table could not be const. Every symbol is named by a macro
+  # now, so the tables are build-time constants and nothing is written.
+  Dir.mktmpdir do |dir|
+    src = File.join(dir, 'syms.rb')
+    out = File.join(dir, 'syms.c')
+    File.write(src, <<~RUBY)
+      def m
+        yield
+      rescue
+        $stdout = $!
+        :"a b"
+      end
+    RUBY
+    result, status = Open3.capture2e(*(cmd_list('mrbc') + ['-S', '-Bsyms', '-o', out, src]))
+    assert_equal 0, status.exitstatus, result
+    c = File.read(out)
+    assert_include c, 'MRB_GVSYM(stdout)'
+    assert_include c, 'MRB_XSYM(2421)'     # $!
+    assert_include c, 'MRB_XSYM(612062)'   # :"a b"
+    assert_not_include c, 'mrb_intern_lit'
+    # each table says const: none is waiting for a write
+    assert_not_include c, '), );'
+  end
+end
