#!/usr/bin/make -f

DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/default.mk
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

INSTALL_ROOT = /usr/lib/sonic-pi

# The engine is SuperSonic, scsynth hosted on clockwork (app/external/
# supersonic and its clockwork submodule). Its distro switches are
# clockwork's, and this is the combination supersonic's own Debian package
# proves in CI (app/external/supersonic/packaging/debian/rules): zlib and
# stb (stb_vorbis) from the archive, and plugin hosting off — the CLAP and
# VST3 SDKs are fetched at configure time and Debian ships neither, so the
# packaged engine has no plugin bridge and no tracks. app/external/
# CMakeLists.txt forwards these into the nested build.
SUPERSONIC_ARGS = \
  -DCLOCKWORK_PLUGINS=OFF \
  -DCLOCKWORK_SYSTEM_ZLIB=ON \
  -DCLOCKWORK_SYSTEM_STB=ON

# Fully offline when the source package carries the component trees
# linux-debian-source.sh produces (mirroring the supersonic repo's
# make-debian-source.sh): `link` (pristine Ableton Link 4.0 — Debian's
# ableton-link-dev is 3.x) and `rust-vendor` (cargo vendor for the committed
# lockfile). Building straight from the git tree without them still works,
# but fetches both from the network.
ifneq (,$(wildcard $(CURDIR)/link))
SUPERSONIC_ARGS += \
  -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
  -DFETCHCONTENT_SOURCE_DIR_ABLETONLINK=$(CURDIR)/link
endif

ifneq (,$(wildcard $(CURDIR)/rust-vendor))
export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_NET_OFFLINE = true
SUPERSONIC_ARGS += -DCLOCKWORK_CARGO_OFFLINE=ON
endif

%:
	dh $@ --buildsystem=cmake --sourcedirectory=app --builddirectory=app

override_dh_auto_configure:
ifneq (,$(wildcard $(CURDIR)/rust-vendor))
	mkdir -p $(CARGO_HOME)
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "%s"\n' \
		"$(CURDIR)/rust-vendor" > $(CARGO_HOME)/config.toml
endif
	# Use system fonts rather than the bundled Hack copies.
	mkdir -p app/gui/fonts/
	ln -sf /usr/share/fonts/truetype/hack/*.ttf app/gui/fonts/
	# The steps linux-pre-translations.sh performs before configuring.
	ruby app/server/ruby/bin/i18n-tool.rb -t
	cp app/gui/utils/ruby_help.tmpl app/gui/utils/ruby_help.h
	ruby app/server/ruby/bin/qt-doc.rb
	dh_auto_configure -- \
	  -DSONIC_PI_INSTALL_ROOT=$(INSTALL_ROOT) \
	  -DBUILD_IMGUI_INTERFACE=OFF \
	  -DQSCINTILLA_ROOT=/usr/include/$(DEB_HOST_MULTIARCH)/qt6 \
	  -DKISSFFT_STATIC=ON \
	  $(SUPERSONIC_ARGS)

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cd app/server/ruby && rake test
	dh_auto_test
endif

override_dh_install:
	dh_install
	# Compiled Ruby C extensions are built against the Ruby that happens to be
	# present; drop them so the pure-Ruby fallbacks are used instead.
	rm -rf debian/sonic-pi-server$(INSTALL_ROOT)/app/server/ruby/rb-native
