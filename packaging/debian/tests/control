# Deterministic. Catches the packaging failure mode that actually happens: a
# file that was not installed, or installed where the resolver does not look.
# Safe to gate on.
Tests: layout
Depends: sonic-pi-server
Restrictions: allow-stderr

# End-to-end, and therefore dependent on an audio stack and on runner speed.
