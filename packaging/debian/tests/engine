#!/bin/sh
# End-to-end check: boot the engine, evaluate a snippet of Sonic Pi code, see
# the output come back, shut down.
#
# Deliberately marked flaky in tests/control. It depends on a working audio
# stack and on how fast the runner is, and a test like this blocking another
# package's migration is precisely what stalled a security update for Sonic Pi
# in 2026. The deterministic checks in tests/layout are the ones that gate.
set -e

SERVER=/usr/lib/sonic-pi/app/server/ruby
WORK="${AUTOPKGTEST_TMP:-/tmp}"
SCRIPT="$WORK/smoke.rb"
OUT="$WORK/headless.log"
TIMEOUT=120

cat > "$SCRIPT" <<'SPI'
puts "autopkgtest-marker-#{1 + 1}"
sleep 0.5
puts "autopkgtest-finished"
SPI

# headless-run.rb boots the daemon, waits for the engine, runs the script for
# the given number of seconds, then exits 0. No audio device is expected in a
# test container: the engine idles rather than failing, so boot, evaluation and
# shutdown are still exercised. setsid so the runner and everything it spawns
# form one process group that can be killed as a unit on timeout.
setsid ruby "$SERVER/bin/headless-run.rb" "$SCRIPT" 20 > "$OUT" 2>&1 &
runner=$!

# Poll for the completion marker rather than sleeping a fixed interval, so a
# slow runner takes longer instead of failing.
elapsed=0
while [ "$elapsed" -lt "$TIMEOUT" ]; do
    if grep -q 'autopkgtest-finished' "$OUT" 2>/dev/null; then
        break
    fi
    if ! kill -0 "$runner" 2>/dev/null; then
        break            # runner exited; the assertions below decide the verdict
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done

# A wedged boot must fail the test, not hang it: kill the whole group before
# waiting, or the wait below blocks forever on a runner that never exits.
if kill -0 "$runner" 2>/dev/null; then
    kill -- -"$runner" 2>/dev/null || kill "$runner" 2>/dev/null || true
    sleep 2
    kill -9 -- -"$runner" 2>/dev/null || true
fi
wait "$runner" 2>/dev/null || true

if [ -n "$AUTOPKGTEST_ARTIFACTS" ]; then
    cp "$OUT" "$AUTOPKGTEST_ARTIFACTS/" 2>/dev/null || true
    if [ -d "$HOME/.sonic-pi" ]; then
        cp -a "$HOME/.sonic-pi" "$AUTOPKGTEST_ARTIFACTS/server.sonic-pi" 2>/dev/null || true
    fi
fi

cat "$OUT"

# The interesting detail of a boot failure is always in the daemon's own logs.
fail() {
    echo "$1" >&2
    for f in "$HOME"/.sonic-pi/log/*.log; do
        [ -f "$f" ] || continue
        echo "=== $f ===" >&2
        cat "$f" >&2
    done
    exit 1
}

grep -q 'READY' "$OUT"                || fail "engine never became ready"
grep -q 'autopkgtest-marker-2' "$OUT" || fail "user code did not evaluate"
grep -q 'autopkgtest-finished' "$OUT" || fail "user code did not complete"

# Written as an if rather than `grep && exit 1`, whose non-match status would
# trip set -e in the passing case.
if grep -q 'SYNTAX ERROR\|ERROR run' "$OUT"; then
    fail "errors reported during run"
fi

echo "PASS: engine booted, evaluated code and shut down"
